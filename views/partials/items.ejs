<section>
  <ul>
  <% if (locals.flower) { %>
    <% flower.forEach((item) =>  {%>
      <li id="<%= item.id %>">
        <ul>
          <li><%=item.name %></li>
          <li><%=item.color %></li>
          <li><%=item.category %></li>
          <li><%=item.arrangement %></li>
          <li><%=item.price %></li>
          <li>
            <form action="/update/<%= item.id %>" method="post">
              <button type="submit">Modify</button>
            </form>
          </li>
          <li>
            <form action="/delete/<%= item.id %>" method="post">
              <button type="submit">Delete</button>
            </form>
          </li>
        </ul>
      </li>
    <% }) %>
  <% } %>
  </ul>
</section>