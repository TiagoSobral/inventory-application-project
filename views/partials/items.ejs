<section>
  <ul>
  <% if (locals.flower) { %>
    <% flower.forEach((item) =>  {%>
      <% if (locals.update && locals.update.id == item.id) {%>
        <%- include('formUpdate') %>
      <% } else {%>
        <li id="<%= item.id %>">
          <ul>
            <li><%=item.flower %></li>
            <li><%=item.color %></li>
            <li><%=item.category %></li>
            <li><%=item.arrangement %></li>
            <li><%=item.price %></li>
            <li>
              <form action="/update/<%= item.id %>" method="get">
                <button type="submit">Modify</button>
              </form>
            </li>
            <li>
              <form action="/delete/<%= item.id %>" method="post">
                <button type="submit">Delete</button>
              </form>
            </li>
          </ul>
        </li>
        <% } %>
      <% }) %>
  <% } %>
  </ul>
</section>