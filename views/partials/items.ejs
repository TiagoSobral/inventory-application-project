
  <ul class="itemsSection">
  <% if (locals.flower) { %>
    <ul class="itemTitles">
      <li>Name</li>
      <li>Color</li>
      <li>Category</li>
      <li>Arrangement</li>
      <li>Price</li>
      </ul>
    <% flower.forEach((item) =>  {%>
      <% if (locals.update && locals.update.id == item.id) {%>
        <%- include('formUpdate') %>
      <% } else {%>
        <li id="<%= item.id %>" class="items">
          <ul class="item">
            <li><%=item.flower %></li>
            <li><%=item.color %></li>
            <li><%=item.category %></li>
            <li><%=item.arrangement %></li>
            <li><%=item.price %></li>
            <li>
              <form action="/update/<%= item.id %>" method="get">
                <button type="submit" class="modify"></button>
              </form>
            </li>
            <li>
              <form action="/delete/<%= item.id %>" method="post">
                <button type="submit" class="delete"></button>
              </form>
            </li>
          </ul>
        </li>
        <% } %>
      <% }) %>
  <% } %>
  </ul>
